@Korp.Stock.Api_HostAddress = https://localhost:7200

### Create Product
POST {{Korp.Stock.Api_HostAddress}}/api/products
Content-Type: application/json

{
  "code": "PROD-CONC-001",
  "description": "Produto Teste Concorrencia",
  "stockQuantity": 1
}

### Get All Products
GET {{Korp.Stock.Api_HostAddress}}/api/products
Accept: application/json

### Get Product By Id
GET {{Korp.Stock.Api_HostAddress}}/api/products/"COLE-AQUI-UM-GUID-REAL"
Accept: application/json

### Debit Stock
POST {{Korp.Stock.Api_HostAddress}}/api/stock/debit
Content-Type: application/json

{
  "invoiceId": "11111111-1111-1111-1111-111111111111",
  "items": [
    {
      "productId": "COLE-UM-PRODUCT-ID-REAL",
      "quantity": 2
    }
  ]
}

### Debit Stock - Idempotency
POST {{Korp.Stock.Api_HostAddress}}/api/stock/debit
Content-Type: application/json

{
  "invoiceId": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
  "items": [
    {
      "productId": "b9db4521-4e53-4ded-8370-4745871117b8",
      "quantity": 2
    }
  ]
}

### Concurrency A
POST {{Korp.Stock.Api_HostAddress}}/api/stock/debit
Content-Type: application/json

{
  "invoiceId": "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
  "items": [
    {
      "productId": "b6c10e89-c773-4b6f-afb4-e5273804a3b0",
      "quantity": 11
    }
  ]
}

### Concurrency B
POST {{Korp.Stock.Api_HostAddress}}/api/stock/debit
Content-Type: application/json

{
  "invoiceId": "cccccccc-cccc-cccc-cccc-cccccccccccc",
  "items": [
    {
      "productId": "b6c10e89-c773-4b6f-afb4-e5273804a3b0",
      "quantity": 11
    }
  ]
}